#include <windows.h>
#include "resource.h"



//
// Manifest resources
//
LANGUAGE 0, SUBLANG_NEUTRAL
1 RT_MANIFEST ".\\manifest.xml"
MAINICON ICON "icon.ico"



//
// Main dialog resources
//
DLG_MAIN DIALOG 0, 0, 180, 176
STYLE DS_CENTER | WS_CAPTION | WS_VISIBLE | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "wpAMP 1.3"
FONT 8, "Ms Shell Dlg"
{
    PUSHBUTTON      "Start All", 0, 6, 42, 52, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Start Server", 1, 64, 42, 52, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Start MySQL", 2, 122, 42, 52, 12, WS_GROUP | WS_TABSTOP
    CONTROL         "", 3, "RichEdit20A", ES_LEFT | WS_VISIBLE | WS_VSCROLL | ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_BORDER, 6, 60, 168, 92
    PUSHBUTTON      "Clear Log", 4, 6, 158, 52, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Browse www", 5, 64, 158, 52, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Terminal", 6, 122, 158, 52, 12, WS_GROUP | WS_TABSTOP
    LTEXT           "Server", IDC_STATIC, 6, 8, 28, 8, SS_NOPREFIX
    COMBOBOX        7, 36, 6, 60, 12, CBS_DROPDOWNLIST | CBS_HASSTRINGS
    PUSHBUTTON      "...", 8, 102, 6, 14, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Config", 9, 122, 6, 32, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "...", 10, 160, 6, 14, 12, WS_GROUP | WS_TABSTOP
    LTEXT           "MySQL", IDC_STATIC, 6, 26, 28, 8, SS_NOPREFIX
    COMBOBOX        11, 36, 24, 80, 12, CBS_DROPDOWNLIST | CBS_HASSTRINGS
    PUSHBUTTON      "Config", 12, 122, 24, 32, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "...", 13, 160, 24, 14, 12, WS_GROUP | WS_TABSTOP
}



//
// Settings dialog resources
//
DLG_CONF DIALOG 0, 0, 150, 42
STYLE DS_CENTER | DS_MODALFRAME | WS_CAPTION | WS_VISIBLE | WS_SYSMENU
FONT 8, "Ms Shell Dlg"
{
    LTEXT           "Port", IDC_STATIC, 10, 8, 20, 8, SS_NOPREFIX
    EDITTEXT        2, 34, 6, 106, 12, ES_LEFT | ES_NUMBER | ES_AUTOHSCROLL | WS_BORDER | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Save", 0, 10, 24, 62, 12, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Cancel", 1, 78, 24, 62, 12, WS_GROUP | WS_TABSTOP
}
